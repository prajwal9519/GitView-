// GitView database schema - authentication, GitHub OAuth & Live Preview Engine phase.

generator client {
  provider = "prisma-client"
  // Prisma 7 generates the client INTO our source tree (not node_modules).
  output = "../src/generated/prisma"
  // Node loads the generated TypeScript files directly (type stripping), so
  // their imports must say ".ts". Needs Node >= 22.18.
  importFileExtension = "ts"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  // The connection URL lives in prisma.config.js (Prisma 7), not here.
}

enum Role {
  USER
  ADMIN
}

enum Provider {
  GITHUB
}

enum PreviewStatus {
  PENDING
  FETCHING
  BUILDING
  STARTING
  RUNNING
  STOPPING
  STOPPED
  FAILED
  EXPIRED
}

enum FrameworkType {
  STATIC
  VITE_REACT
  VITE_VANILLA
  REACT
  UNKNOWN
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique // nullable: GitHub users may hide their email
  username     String   @unique
  passwordHash String? // bcrypt hash; null for GitHub-only accounts
  avatarUrl    String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens   RefreshToken[]
  oauthAccounts   OAuthAccount[]
  repositories    Repository[]
  previewSessions PreviewSession[]
}

// One row per refresh token we ever issued. This table is what makes refresh
// tokens revocable, rotatable, and lets us detect a stolen token being replayed.
model RefreshToken {
  id        String    @id @default(uuid()) // also the JWT "jti" claim
  userId    String
  familyId  String // every token descended from one login shares this
  tokenHash String // SHA-256 of the token string (never the token itself)
  expiresAt DateTime
  revokedAt DateTime? // set when rotated, logged out, or family revoked
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// Linked third-party OAuth identities (e.g. GitHub).
// Stores AES-256-GCM encrypted access tokens so they never leak from database dumps.
model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          Provider
  providerAccountId String   // GitHub numeric user ID stored as string
  accessTokenEnc    String   // AES-256-GCM encrypted token
  scope             String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

// Imported repositories scoped to users.
// Tracks repository metadata, branches, and commit status.
model Repository {
  id              String   @id @default(uuid())
  userId          String
  githubRepoId    String   // GitHub numeric repo ID stored as string
  owner           String   // e.g. "facebook"
  name            String   // e.g. "react"
  fullName        String   // e.g. "facebook/react"
  description     String?
  htmlUrl         String   // e.g. "https://github.com/facebook/react"
  defaultBranch   String   @default("main")
  latestCommitSha String?  // default branch's latest commit SHA
  primaryLanguage String?  // e.g. "JavaScript", "TypeScript"
  isPrivate       Boolean  @default(false)
  importedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  previewSessions PreviewSession[]

  @@unique([userId, githubRepoId])
  @@index([userId])
  @@index([fullName])
}

// Live application preview sessions.
// Implements Option A proxy-sidecar isolation architecture.
model PreviewSession {
  id                String        @id @default(uuid())
  userId            String
  repositoryId      String
  status            PreviewStatus @default(PENDING)
  framework         FrameworkType @default(UNKNOWN)
  projectRoot       String?       // Normalized relative path to nested app root (e.g. "vite-project")
  isActive          Boolean       @default(true)
  tokenHash         String        @unique // SHA-256 of preview token for O(1) indexed lookup
  previewTokenEnc   String        // AES-256-GCM encrypted token for reconstruction on workspace refresh
  commitSha         String
  branch            String
  runnerContainerId String?       // Isolated preview runner Docker container ID (internal)
  proxyContainerId  String?       // Trusted reverse proxy sidecar Docker container ID (actual Docker engine ID)
  proxyInstanceId   String?       // Cryptographically random immutable UUID generated for sidecar instance identity
  proxyPort         Int?          // Dynamically assigned host loopback port for proxy sidecar
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  startedAt         DateTime?
  stoppedAt         DateTime?
  expiresAt         DateTime      // Hard ceiling TTL
  lastActiveAt      DateTime      @default(now()) // Updated on activity for idle timeout
  errorCode         String?
  errorMessage      String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  // Enforces MVP concurrency policy: max 1 active preview session per user
  @@unique([userId], where: { isActive: true })
  @@index([userId])
  @@index([repositoryId])
  @@index([status])
  @@index([isActive, expiresAt])
  @@index([isActive, lastActiveAt])
}
