# Copy this file to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string for the development database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/gitview

# Origin of the frontend (used for the CORS allow-list). No trailing slash.
FRONTEND_URL=http://localhost:5173

# Two DIFFERENT secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# bcrypt work factor (12 is a good default; each +1 doubles the time).
BCRYPT_COST=12

# Failed login/register attempts allowed per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=10

# How many reverse proxies sit in front of the app (0 = none, 1 = Render/Heroku/nginx).
TRUST_PROXY=0

# GitHub OAuth App credentials (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# Optional server-side GitHub Personal Access Token (PAT) for rate-limit resilience on public repos
# Elevates unauthenticated API quota from 60/hr to 5,000/hr. Never exposed to clients.
GITHUB_TOKEN=

# AES-256-GCM encryption key for GitHub access tokens (32 bytes = 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Dedicated AES-256-GCM encryption key for preview tokens (32 bytes = 64 hex characters)
# Must be separate and distinct from ENCRYPTION_KEY
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PREVIEW_TOKEN_ENCRYPTION_KEY=

# Dedicated HMAC-SHA256 secret for gateway-to-sidecar handshake (32 bytes = 64 hex characters)
# Must be separate and distinct from ENCRYPTION_KEY and PREVIEW_TOKEN_ENCRYPTION_KEY
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITVIEW_SIDECAR_HANDSHAKE_KEY=

# Milestone 7: Redis Ticket Registry & Preview Gateway Configuration
# REDIS_URL is mandatory in production (e.g. redis://127.0.0.1:6379), optional in local development (falls back to MemoryTicketStore)
REDIS_URL=redis://127.0.0.1:6379
# Dedicated preview root domain for production (e.g. gitview-preview.com)
PREVIEW_DOMAIN=
# Optional preview base URL override (e.g. http://preview.localhost:3000)
PREVIEW_BASE_URL=
# Enable HTTPS for local previews (true/false, default false)
PREVIEW_HTTPS=false

# Used only by `npm run db:seed` to create the first admin. Remove after seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
