# Copy this file to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string for the development database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/gitview

# Origin of the frontend (used for the CORS allow-list). No trailing slash.
FRONTEND_URL=http://localhost:5173

# Two DIFFERENT secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# bcrypt work factor (12 is a good default; each +1 doubles the time).
BCRYPT_COST=12

# Failed login/register attempts allowed per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=10

# How many reverse proxies sit in front of the app (0 = none, 1 = Render/Heroku/nginx).
TRUST_PROXY=0

# GitHub OAuth App credentials (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# AES-256-GCM encryption key for GitHub access tokens (32 bytes = 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Used only by `npm run db:seed` to create the first admin. Remove after seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
