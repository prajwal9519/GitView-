{
  "name": "gitview-backend",
  "version": "0.1.0",
  "private": true,
  "description": "GitView backend - authentication module",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:test:migrate": "node --env-file=.env.test ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.1",
    "pg": "8.23.1",
    "tar-stream": "^3.1.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "vitest": "5.1.0"
  }
}
